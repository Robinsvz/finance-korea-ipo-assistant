# Core
DATABASE_URL=sqlite:///data/ipo.db
IPO_TIMEZONE=Asia/Seoul
IPO_DEFAULT_USER_CASH=10000000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
# /refresh는 데이터 쓰기 작업이므로 실행을 허용할 개인 Telegram user id 목록
TELEGRAM_REFRESH_ALLOWED_USER_IDS=

# Email (default recipient is fixed; leave EMAIL_FROM and SMTP_HOST empty to disable delivery)
EMAIL_TO=dummy1.kim@gmail.com
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls or ssl
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SEC=20
# 월간 전체 roster를 제공하는 기본 제품 모드. 검증 표본 30개 전에는 history flag를 켜지 않습니다.
EMAIL_PRODUCT_MODE=v3-facts
HISTORICAL_EVIDENCE_ENABLED=false
EMAIL_MAX_HTML_BYTES=90000

# OpenDART
DART_API_KEY=
# API key가 없을 때 공식 DART 공개 검색/문서 viewer를 사용하는 read-only fallback
DART_PUBLIC_FALLBACK_ENABLED=true

# Naver Open API: Search API and DataLab API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Collection controls
HTTP_TIMEOUT_SEC=20
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SEC=0.5
KIND_LOOKBACK_DAYS=180
KIND_LOOKAHEAD_DAYS=365
